# Tankery Insanery - MTC Match Manager
# Copyright © Nan's Studio's. All rights reserved.
# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Discord (required) ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
TI_ADMIN_ROLE_ID=
TI_REFEREE_ROLE_ID=

# --- Channels (optional) ---
MATCH_CHANNEL_ID=
LOADOUT_CHANNEL_ID=
ADMIN_LOG_CHANNEL_ID=

# --- Storage ---
DATABASE_PATH=./data/tankery.sqlite
BACKUP_DIR=./backups
ENABLE_DATABASE_BACKUPS=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# --- General ---
LOG_LEVEL=info
BOT_NAME=Tankery Insanery - MTC Match Manager
BOT_VERSION=1.1.2

# --- Matches ---
MAX_MATCH_TEAMS=10
MAX_SCHOOLS_PER_MATCH=20
ALLOW_DUPLICATE_SCHOOLS=false

# --- Access ---
ALLOW_PUBLIC_LOADOUT_VIEW=true
ALLOW_REFEREE_EXPORT=true
ADMIN_IMPLIES_REFEREE=true

# --- Embed colours (hex) ---
EMBED_COLOR_PRIMARY=#2F5D3A
EMBED_COLOR_SUCCESS=#2ECC71
EMBED_COLOR_ERROR=#E74C3C
EMBED_COLOR_WARNING=#F1C40F
EMBED_COLOR_INFO=#3498DB
EMBED_COLOR_EAGLE=#3B82F6
EMBED_COLOR_HAWK=#EF4444
